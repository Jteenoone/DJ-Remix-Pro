<?xml version="1.0" encoding="utf-8"?>
<!-- S2 Onboarding 3 pages (canvas #2e/#2f/#2g, MixDeck:120-175). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_booth"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_skip"
            style="@style/Widget.MixDeck.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="end|center_vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/action_skip"
            android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
            android:textColor="@color/md_muted" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants">

        <!-- Page 1: two discs 150, label 56 (MixDeck:126-129). -->
        <FrameLayout
            android:id="@+id/page_decks"
            android:layout_width="260dp"
            android:layout_height="150dp"
            android:layout_gravity="center">

            <com.example.djremixpro.core.ui.widget.VinylArtView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="start"
                app:mdDeck="a"
                app:mdLabelSize="56dp"
                app:mdLabelText="@string/deck_letter_a"
                app:mdLabelTextSize="22sp"
                app:mdRimThemed="false" />

            <com.example.djremixpro.core.ui.widget.VinylArtView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="end"
                app:mdDeck="b"
                app:mdLabelSize="56dp"
                app:mdLabelText="@string/deck_letter_b"
                app:mdLabelTextSize="22sp"
                app:mdRimThemed="false" />
        </FrameLayout>

        <!-- Page 2: two waveforms + playhead, Sync pill (MixDeck:147-153). -->
        <LinearLayout
            android:id="@+id/page_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="296dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_r16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_8"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_12">

                    <com.example.djremixpro.core.ui.widget.ScrollingWaveformView
                        android:id="@+id/wave_a"
                        android:layout_width="280dp"
                        android:layout_height="44dp"
                        app:mdDeck="a"
                        app:mdShowLabel="false" />

                    <com.example.djremixpro.core.ui.widget.ScrollingWaveformView
                        android:id="@+id/wave_b"
                        android:layout_width="280dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/space_8"
                        app:mdDeck="b"
                        app:mdShowLabel="false" />
                </LinearLayout>

                <!-- Playhead: top/bottom 8 inside the 120dp card (12 + 44 + 8 + 44 + 12) = 104dp. Fixed height,
                     a match_parent child would stretch the wrap_content card to the whole area. -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@color/md_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="112dp"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_sync_on_b"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/shape_circle_deck_b" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/mixer_sync"
                    android:textAppearance="@style/TextAppearance.MixDeck.Subheading"
                    android:textColor="@color/md_deck_b" />
            </LinearLayout>
        </LinearLayout>

        <!-- Page 3: recording ring + timer (MixDeck:162-165). -->
        <LinearLayout
            android:id="@+id/page_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:background="@drawable/bg_rec_ring">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shape_circle_rec" />
            </FrameLayout>

            <!-- Mock elapsed time of the illustration (number, not translated). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="00:42"
                android:textAppearance="@style/TextAppearance.MixDeck.Numeric.BpmLarge"
                android:textColor="@color/md_rec"
                app:lineHeight="26sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/mixer_recording"
                android:textAppearance="@style/TextAppearance.MixDeck.Caption"
                android:textColor="@color/md_rec" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:breakStrategy="balanced"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MixDeck.Title"
            app:lineHeight="30sp"
            tools:text="@string/onboarding_1_title" />

        <LinearLayout
            android:id="@+id/layout_indicator"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_next"
            style="@style/Widget.MixDeck.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/action_next" />
    </LinearLayout>
</LinearLayout>
