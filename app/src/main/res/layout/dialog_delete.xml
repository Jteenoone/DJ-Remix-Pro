<?xml version="1.0" encoding="utf-8"?>
<!--
  Delete recording confirmation (D-13), design dialog style (MixDeck:695-701 "Đặt lại bản mix?"):
  title 18/24 600, body 14/20 muted, "Huỷ" ghost + "Xoá" filled in rec colour with booth text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <TextView
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/recording_delete_title"
        android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

    <TextView
        android:id="@+id/text_body"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.MixDeck.Body.Muted"
        tools:text="“Mix 25-09 21:40” sẽ bị xoá khỏi máy." />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_14"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.MixDeck.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_dialog_height"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/action_cancel"
            android:textAppearance="@style/TextAppearance.MixDeck.Button"
            android:textColor="@color/md_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm"
            style="@style/Widget.MixDeck.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_dialog_height"
            android:layout_marginStart="@dimen/space_8"
            android:minHeight="@dimen/button_dialog_height"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/recording_delete"
            app:backgroundTint="@color/sel_button_danger_bg" />
    </LinearLayout>
</LinearLayout>
