<?xml version="1.0" encoding="utf-8"?>
<!-- Tip card (App:180-184): panel r16 padding 16 gap 8; tag chip + read time, title 16/22 600, body 14/20 muted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_10"
    android:background="@drawable/bg_panel_r16"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_tag"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_raised_r4"
            android:gravity="center"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption"
            tools:text="EQ" />

        <TextView
            android:id="@+id/text_read_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption"
            tools:text="2 phút đọc" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_title"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.MixDeck.Subheading"
        tools:text="Cắt Low trước khi chuyển bài" />

    <TextView
        android:id="@+id/text_body"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.MixDeck.Body.Muted"
        tools:text="Nội dung mẹo." />
</LinearLayout>
