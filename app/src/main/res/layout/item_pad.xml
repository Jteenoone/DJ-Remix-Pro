<?xml version="1.0" encoding="utf-8"?>
<!-- Performance pad (Mixer:147-151): r10, 1.5 border, label (Chakra 18 / 14 or Be Vietnam 12) + optional sub 12/14 at 85%. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_2"
    android:paddingEnd="@dimen/space_2">

    <TextView
        android:id="@+id/text_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Pad"
        tools:text="1" />

    <TextView
        android:id="@+id/text_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:alpha="0.85"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.MixDeck.Caption"
        app:lineHeight="14sp"
        tools:text="0:32" />
</LinearLayout>
