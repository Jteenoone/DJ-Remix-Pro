<?xml version="1.0" encoding="utf-8"?>
<!-- Glossary entry (App:168-174): padding 14/4/6, term 16/22 600, description 14/20 muted, link row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_line"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_14"
    android:paddingEnd="@dimen/space_4"
    android:paddingBottom="@dimen/space_6">

    <TextView
        android:id="@+id/text_term"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MixDeck.Subheading"
        tools:text="Crossfader" />

    <TextView
        android:id="@+id/text_description"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textAppearance="@style/TextAppearance.MixDeck.Body.Muted"
        tools:text="Thanh trượt ngang để chuyển âm thanh giữa hai deck." />

    <LinearLayout
        android:id="@+id/button_see_on_mixer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/sel_transparent_r12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learn_see_on_mixer"
            android:textAppearance="@style/TextAppearance.MixDeck.Button"
            android:textColor="@color/md_text" />

        <ImageView
            android:layout_width="@dimen/icon_16"
            android:layout_height="@dimen/icon_16"
            android:layout_marginStart="@dimen/space_6"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/md_text" />
    </LinearLayout>
</LinearLayout>
