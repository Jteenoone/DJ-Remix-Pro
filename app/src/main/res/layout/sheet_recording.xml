<?xml version="1.0" encoding="utf-8"?>
<!-- O2 Recording sheet (App:244-258, 331-337): header cover "MIX", actions Đổi tên / Chia sẻ / Xoá (rec). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_10"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_24">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_8"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:background="@drawable/bg_bottom_line"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_12">

        <TextView
            android:id="@+id/text_cover"
            android:layout_width="@dimen/cover_size_sheet"
            android:layout_height="@dimen/cover_size_sheet"
            android:background="@drawable/bg_raised_r8"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/recording_cover_label"
            android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Badge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MixDeck.Subheading"
                tools:text="Mix 25-09 21:40" />

            <TextView
                android:id="@+id/text_meta"
                android:textAlignment="viewStart"
                android:textDirection="ltr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MixDeck.Caption"
                tools:text="03:12 · 25/09/2026" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_rename"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/sel_transparent_r12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:layout_width="@dimen/icon_20"
                android:layout_height="@dimen/icon_20"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit"
                app:tint="@color/md_text" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:text="@string/recording_rename"
            android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
            android:textColor="@color/md_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_share"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/sel_transparent_r12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:layout_width="@dimen/icon_20"
                android:layout_height="@dimen/icon_20"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_share"
                app:tint="@color/md_text" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:text="@string/action_share"
            android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
            android:textColor="@color/md_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_delete"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/sel_transparent_r12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:layout_width="@dimen/icon_20"
                android:layout_height="@dimen/icon_20"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_delete"
                app:tint="@color/md_rec" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:text="@string/recording_delete"
            android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
            android:textColor="@color/md_rec" />
    </LinearLayout>
</LinearLayout>
