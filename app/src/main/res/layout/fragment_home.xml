<?xml version="1.0" encoding="utf-8"?>
<!-- S4 Home (App:30-97): scroll content padding 4/16/24, sections 24 apart. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_booth"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_space_24"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_24"
        android:showDividers="middle">

        <!-- 1. "Sẵn sàng mix?" card (App:31-40). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_r16"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="76dp"
                android:importantForAccessibility="noHideDescendants">

                <com.example.djremixpro.core.ui.widget.VinylArtView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="start"
                    app:mdDeck="a"
                    app:mdLabelSize="26dp"
                    app:mdLabelText="@string/deck_letter_a"
                    app:mdLabelTextSize="12sp"
                    app:mdRimThemed="true" />

                <com.example.djremixpro.core.ui.widget.VinylArtView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="end"
                    app:mdDeck="b"
                    app:mdLabelSize="26dp"
                    app:mdLabelText="@string/deck_letter_b"
                    app:mdLabelTextSize="12sp"
                    app:mdRimThemed="true" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:accessibilityHeading="true"
                android:text="@string/home_ready_title"
                android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_open_mixer"
                style="@style/Widget.MixDeck.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_height"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/action_open_mixer"
                app:icon="@drawable/ic_deck"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/space_8"
                app:iconSize="@dimen/icon_18" />
        </LinearLayout>

        <!-- 2. New user: samples card (App:42-50). -->
        <LinearLayout
            android:id="@+id/card_samples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_r16"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:textAlignment="viewStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_samples_title"
                    android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_deck_b_r6"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:text="@string/badge_new"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Semibold"
                    android:textColor="@color/md_booth" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_sample_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mix_samples"
                style="@style/Widget.MixDeck.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_outline_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/home_samples_action" />
        </LinearLayout>

        <!-- 3. Returning user: resume session (App:52-64). -->
        <LinearLayout
            android:id="@+id/section_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/home_resume_title"
                android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

            <LinearLayout
                android:id="@+id/card_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/sel_panel_r16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_6"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/space_6">

                <LinearLayout
                    android:id="@+id/layout_session_rows"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <ImageView
                    android:layout_width="@dimen/icon_20"
                    android:layout_height="@dimen/icon_20"
                    android:layout_marginStart="@dimen/space_8"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/md_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Learn tiles (App:66-73). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:textAlignment="viewStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_learn_title"
                    android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_learn_all"
                    style="@style/Widget.MixDeck.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginEnd="-8dp"
                    android:text="@string/action_see_all" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tile_guide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sel_panel_r12"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_20"
                        android:layout_height="@dimen/icon_20"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_learn_guide"
                        app:tint="@color/md_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="@string/learn_tile_guide"
                        android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium"
                        android:textColor="@color/md_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_terms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@drawable/sel_panel_r12"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_20"
                        android:layout_height="@dimen/icon_20"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_learn_terms"
                        app:tint="@color/md_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="@string/learn_tile_terms"
                        android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium"
                        android:textColor="@color/md_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_tips"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@drawable/sel_panel_r12"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_20"
                        android:layout_height="@dimen/icon_20"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_learn_tips"
                        app:tint="@color/md_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="@string/learn_tile_tips"
                        android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium"
                        android:textColor="@color/md_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Ad placeholder (App:75-80, D-23). -->
        <LinearLayout
            android:id="@+id/card_ad"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_ad_placeholder"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_14"
            android:paddingEnd="@dimen/space_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/bg_raised_r4"
                android:gravity="center"
                android:paddingStart="@dimen/space_6"
                android:paddingEnd="@dimen/space_6"
                android:text="@string/home_ad_label"
                android:textAppearance="@style/TextAppearance.MixDeck.Caption" />

            <TextView
                android:textAlignment="viewStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="@string/home_ad_placeholder"
                android:textAppearance="@style/TextAppearance.MixDeck.Caption" />
        </LinearLayout>

        <!-- 6. Returning user: recent mixes (App:82-96). -->
        <LinearLayout
            android:id="@+id/section_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:textAlignment="viewStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_recent_title"
                    android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_recent_all"
                    style="@style/Widget.MixDeck.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginEnd="-8dp"
                    android:text="@string/action_see_all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_recent_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
