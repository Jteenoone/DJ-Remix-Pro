<?xml version="1.0" encoding="utf-8"?>
<!-- Library song row (App:113-117): 60 tall, cover 44 r8, title 14/20, subtitle 12/16, BPM badge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_song_height"
    android:background="@drawable/sel_transparent_r12"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/text_cover"
        android:layout_width="@dimen/cover_size"
        android:layout_height="@dimen/cover_size"
        android:background="@drawable/bg_cover_r8"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Small"
        tools:backgroundTint="@color/md_cover_4"
        tools:text="SG" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_title"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MixDeck.Body"
            tools:text="Sài Gòn lên đèn" />

        <TextView
            android:id="@+id/text_subtitle"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption"
            tools:text="Mây Tầng Thượng · 04:12" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_12"
        android:background="@drawable/bg_badge_bpm"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:minWidth="52dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <TextView
            android:id="@+id/text_bpm"
            android:textDirection="ltr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Badge"
            tools:text="124" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:includeFontPadding="false"
            android:text="@string/bpm_unit"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption" />
    </LinearLayout>
</LinearLayout>
