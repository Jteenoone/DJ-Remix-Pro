<?xml version="1.0" encoding="utf-8"?>
<!-- O5 Mixer library panel (Mixer:319-359): scrim 55 % + right panel 480, r24 on the left, border-left line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_scrim_panel"
        android:contentDescription="@string/mixer_library_close_cd" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_library_panel"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_10"
        android:paddingEnd="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.MixDeck.Heading"
                tools:text="Chọn bài cho Deck B" />

            <ImageButton
                android:id="@+id/button_close"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/sel_transparent_r12"
                android:contentDescription="@string/mixer_library_close_cd"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/md_muted" />
        </LinearLayout>

        <!-- Search / sort / tabs are static in the design (Mixer:328-340). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/space_8"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_booth_line_r12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12">

                <ImageView
                    android:layout_width="@dimen/icon_18"
                    android:layout_height="@dimen/icon_18"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:maxLines="1"
                    android:text="@string/library_search_hint"
                    android:textAppearance="@style/TextAppearance.MixDeck.Body.Muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_raised_r12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12">

                <TextView
                    android:id="@+id/text_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium"
                    android:textColor="@color/md_text"
                    tools:text="Sắp xếp: BPM" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="@dimen/space_6"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/md_text" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:importantForAccessibility="noHideDescendants"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_text_r14"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="@string/library_tab_songs"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium"
                    android:textColor="@color/md_booth" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_raised_r14"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="@string/library_tab_playlists"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_raised_r14"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="@string/library_tab_albums"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_raised_r14"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="@string/library_tab_artists"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_raised_r14"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="@string/library_tab_folders"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption.Medium" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_8"
            android:layout_weight="1"
            android:scrollbars="none"
            tools:listitem="@layout/item_library_panel_row" />
    </LinearLayout>
</FrameLayout>
