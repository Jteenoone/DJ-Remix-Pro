<?xml version="1.0" encoding="utf-8"?>
<!-- S6 Recordings (App:122-143): list (rows 72, gap 2, margin -8) or empty state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_booth">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_recordings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_24"
        android:scrollbars="none"
        tools:listitem="@layout/item_recording" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingTop="80dp"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_24">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/sel_circle_panel">

                <ImageView
                    android:layout_width="@dimen/icon_40"
                    android:layout_height="@dimen/icon_40"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_recordings"
                    app:tint="@color/md_muted" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:gravity="center"
                android:text="@string/recordings_empty"
                android:textAppearance="@style/TextAppearance.MixDeck.Body.Muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_open_mixer"
                style="@style/Widget.MixDeck.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_primary_height"
                android:layout_marginTop="@dimen/space_20"
                android:paddingStart="@dimen/space_28"
                android:paddingEnd="@dimen/space_28"
                android:text="@string/action_open_mixer" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
