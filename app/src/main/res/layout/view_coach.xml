<?xml version="1.0" encoding="utf-8"?>
<!--
  O8 Coach mark (Mixer:297-317): CoachOverlayView draws the scrim + spotlight and places the bubble
  (256 wide, text background, r16, padding 14/16, gap 8) above the target.
-->
<com.example.djremixpro.core.ui.widget.CoachOverlayView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_text_r16"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_14"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_14">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Bold"
                android:textColor="@color/md_booth"
                tools:text="Bước 3/5" />

            <LinearLayout
                android:id="@+id/layout_steps"
                android:layout_width="wrap_content"
                android:layout_height="4dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.MixDeck.Subheading"
            android:textColor="@color/md_booth"
            tools:text="Chạm Sync ở Deck B" />

        <TextView
            android:id="@+id/text_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.MixDeck.Body"
            android:textColor="@color/md_inv_muted"
            tools:text="Sync chỉnh tốc độ Deck B cho khớp nhịp Deck A đang phát." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_skip"
                style="@style/Widget.MixDeck.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_dialog_height"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/action_skip"
                android:textAppearance="@style/TextAppearance.MixDeck.Button"
                android:textColor="@color/md_booth" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next"
                style="@style/Widget.MixDeck.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_dialog_height"
                android:layout_marginStart="@dimen/space_4"
                android:minHeight="@dimen/button_dialog_height"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/action_next"
                android:textColor="@color/md_text"
                app:backgroundTint="@color/md_booth"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>
    </LinearLayout>
</com.example.djremixpro.core.ui.widget.CoachOverlayView>
