<?xml version="1.0" encoding="utf-8"?>
<!-- S7 Learn (App:145-189): segmented Hướng dẫn / Thuật ngữ / Mẹo and one list per segment. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_booth"
    android:scrollbars="none">

    <!-- clipToPadding off: the guide list uses margin -8 (App:152) and must not be clipped by the 16dp padding. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:id="@+id/layout_segments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_r12"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/segment_guide"
                android:layout_width="0dp"
                android:layout_height="@dimen/segment_height"
                android:layout_weight="1"
                android:background="@drawable/sel_segment"
                android:gravity="center"
                android:text="@string/learn_seg_guide"
                android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
                android:textColor="@color/sel_segment_text" />

            <TextView
                android:id="@+id/segment_terms"
                android:layout_width="0dp"
                android:layout_height="@dimen/segment_height"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/sel_segment"
                android:gravity="center"
                android:text="@string/learn_seg_terms"
                android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
                android:textColor="@color/sel_segment_text" />

            <TextView
                android:id="@+id/segment_tips"
                android:layout_width="0dp"
                android:layout_height="@dimen/segment_height"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/sel_segment"
                android:gravity="center"
                android:text="@string/learn_seg_tips"
                android:textAppearance="@style/TextAppearance.MixDeck.Body.Medium"
                android:textColor="@color/sel_segment_text" />
        </LinearLayout>

        <!-- Guide: rows 60, gap 2, container margin -8 (App:151-163). -->
        <LinearLayout
            android:id="@+id/section_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="-8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_progress"
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:paddingBottom="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.MixDeck.Caption"
                tools:text="Đã học 2/7 bài · mỗi bài mở bàn DJ và chỉ từng nút" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_lessons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="7"
                tools:listitem="@layout/item_lesson" />
        </LinearLayout>

        <!-- Terms: search (filters for real, contract v1.2) + glossary (App:165-176). -->
        <LinearLayout
            android:id="@+id/section_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_height"
                android:layout_marginBottom="@dimen/space_4"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12">

                <ImageView
                    android:layout_width="@dimen/icon_18"
                    android:layout_height="@dimen/icon_18"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_muted" />

                <EditText
                    android:id="@+id/edit_terms_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/learn_terms_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.MixDeck.Body"
                    android:textColorHint="@color/md_muted" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_glossary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_glossary" />

            <TextView
                android:id="@+id/text_terms_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center"
                android:text="@string/learn_terms_empty"
                android:textAppearance="@style/TextAppearance.MixDeck.Body.Muted"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tips: cards gap 10 (App:178-187). -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:itemCount="2"
            tools:listitem="@layout/item_tip" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
