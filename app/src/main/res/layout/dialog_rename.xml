<?xml version="1.0" encoding="utf-8"?>
<!--
  Rename recording (D-13) in the design's dialog style (like dialog_save_mix, Mixer:268-293):
  panel r20 + line border (window background), padding 20, title 18/24 600, label 12 muted,
  input 44 booth r12 with 1.5 text border, actions 44: "Huỷ" ghost + "Lưu" primary.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <TextView
        android:id="@+id/text_title"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/recording_rename_title"
        android:textAppearance="@style/TextAppearance.MixDeck.Heading" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        android:labelFor="@id/edit_name"
        android:text="@string/recording_name_hint"
        android:textAppearance="@style/TextAppearance.MixDeck.Caption" />

    <EditText
        android:id="@+id/edit_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_booth_input"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:textAppearance="@style/TextAppearance.MixDeck.Body"
        android:textCursorDrawable="@null"
        tools:text="Mix 25-09 21:40" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_14"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.MixDeck.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_dialog_height"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/action_cancel"
            android:textAppearance="@style/TextAppearance.MixDeck.Button"
            android:textColor="@color/md_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm"
            style="@style/Widget.MixDeck.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_dialog_height"
            android:layout_marginStart="@dimen/space_8"
            android:minHeight="@dimen/button_dialog_height"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
