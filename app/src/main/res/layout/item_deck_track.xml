<?xml version="1.0" encoding="utf-8"?>
<!-- Deck row of the Home samples / resume cards (App:46, App:57): letter 24 · title 14 · BPM Chakra 13 + "BPM" 12. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/text_deck"
        android:fontFamily="@font/chakra_petch_semibold"
        android:layout_width="@dimen/deck_letter_size"
        android:layout_height="@dimen/deck_letter_size"
        android:background="@drawable/bg_deck_a_r6"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Letter"
        android:textColor="@color/md_booth"
        tools:text="A" />

    <TextView
        android:id="@+id/text_title"
        android:textAlignment="viewStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.MixDeck.Body"
        tools:text="Sài Gòn lên đèn" />

    <!-- "124 BPM": own ltr group (never "BPM 124" in RTL) with baseline alignment; the row's
         center_vertical gravity disables baseline alignment for its direct children. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:baselineAligned="true"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_bpm"
            android:textDirection="ltr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Badge"
            tools:text="124" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:text="@string/bpm_unit"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption" />
    </LinearLayout>
</LinearLayout>
