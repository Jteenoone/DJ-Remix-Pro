<?xml version="1.0" encoding="utf-8"?>
<!-- App shell (App.dc.html:19-265): top bar 60 · content · mini player 64 · bottom nav 72 · toast overlay. Owner: lead. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_booth">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/Widget.MixDeck.IconButton"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginEnd="@dimen/space_4"
            android:contentDescription="@string/action_back"
            android:visibility="gone"
            app:icon="@drawable/ic_back"
            app:iconTint="@color/md_text" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_4"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MixDeck.Title"
            android:accessibilityHeading="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings"
            style="@style/Widget.MixDeck.IconButton"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/action_settings"
            app:icon="@drawable/ic_tune"
            app:iconSize="@dimen/icon_22"
            app:iconTint="@color/md_muted" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/mini_player"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:navGraph="@navigation/nav_graph" />

    <com.example.djremixpro.core.ui.widget.MiniPlayerView
        android:id="@+id/mini_player"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/bottom_nav_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_1"
        android:background="@color/md_line"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/md_panel"
        android:minHeight="@dimen/bottom_nav_height"
        app:activeIndicatorLabelPadding="@dimen/space_4"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.DJRemixPro.NavIndicator"
        app:itemIconSize="@dimen/icon_22"
        app:itemIconTint="@color/shell_nav_item"
        app:itemPaddingBottom="@dimen/space_10"
        app:itemPaddingTop="@dimen/space_10"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextAppearanceActive="@style/TextAppearance.MixDeck.Caption.Semibold"
        app:itemTextAppearanceActiveBoldEnabled="false"
        app:itemTextAppearanceInactive="@style/TextAppearance.MixDeck.Caption.Medium"
        app:itemTextColor="@color/shell_nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav" />

    <!-- Toast sits 16dp above the mini player, or above the bottom nav when the player is hidden (D-24). -->
    <com.example.djremixpro.core.ui.widget.ToastView
        android:id="@+id/toast"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:elevation="@dimen/space_2"
        app:layout_constraintBottom_toTopOf="@id/mini_player"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
