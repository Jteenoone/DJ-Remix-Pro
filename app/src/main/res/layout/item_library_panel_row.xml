<?xml version="1.0" encoding="utf-8"?>
<!-- Mixer library row (Mixer:343-355): min 52, gap 10, bottom line; cover 36 r6, title/artist · dur, BPM badge, A / B. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_line"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/text_cover"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_cover_r6"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Small"
        android:textColor="@color/md_text"
        tools:backgroundTint="@color/md_cover_3"
        tools:text="CV" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MixDeck.Body"
            tools:text="Chạy về phía biển" />

        <TextView
            android:id="@+id/text_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption"
            tools:text="Vy Hạ · 03:48" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_badge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_badge_bpm_booth"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:minWidth="52dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8">

            <TextView
                android:id="@+id/text_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Badge"
                tools:text="122" />

            <TextView
                android:id="@+id/text_bpm_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text="@string/bpm_unit"
                android:textAppearance="@style/TextAppearance.MixDeck.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:maxLines="1"
            android:text="@string/mixer_bpm_match_short"
            android:textAppearance="@style/TextAppearance.MixDeck.Caption"
            android:textColor="@color/md_deck_a"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/button_load_a"
        android:fontFamily="@font/chakra_petch_semibold"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="10dp"
        android:background="@drawable/sel_outline_deck_a"
        android:clickable="true"
        android:contentDescription="@string/mixer_load_a_cd"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/deck_letter_a"
        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Bold"
        android:textColor="@color/md_deck_a" />

    <TextView
        android:id="@+id/button_load_b"
        android:fontFamily="@font/chakra_petch_semibold"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="10dp"
        android:background="@drawable/sel_outline_deck_b"
        android:clickable="true"
        android:contentDescription="@string/mixer_load_b_cd"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/deck_letter_b"
        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Bold"
        android:textColor="@color/md_deck_b" />
</LinearLayout>
