<?xml version="1.0" encoding="utf-8"?>
<!--
  O6 FX sheet (Mixer:217-264): scrim 60 %, sheet left/right 40, height 308, r24 top, padding 8/20/16.
  Left column 248: header, Wet/Dry knob (fixed 60 %, D-22), beat lengths, reset. Right: readout + XY pad.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_scrim_fx"
        android:contentDescription="@string/action_close" />

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="308dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_fx_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_16">

        <View
            android:layout_width="@dimen/sheet_handle_width"
            android:layout_height="@dimen/sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="248dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_deck_letter"
                        android:fontFamily="@font/chakra_petch_semibold"
                        android:layout_width="@dimen/deck_letter_size"
                        android:layout_height="@dimen/deck_letter_size"
                        android:background="@drawable/bg_deck_a_r6"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextAppearance.MixDeck.Numeric.Letter"
                        android:textColor="@color/md_booth"
                        tools:text="A" />

                    <TextView
                        android:id="@+id/text_fx_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.MixDeck.Heading"
                        tools:text="Echo" />

                    <!-- Same switch as Settings (App:207) with the deck colour when on (Mixer:226). 44dp touch height. -->
                    <FrameLayout
                        android:id="@+id/switch_fx"
                        android:layout_width="@dimen/switch_width"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_8"
                        android:clickable="true"
                        android:focusable="true">

                        <com.example.djremixpro.core.ui.widget.MdSwitchView
                            android:id="@+id/switch_fx_view"
                            android:layout_width="@dimen/switch_width"
                            android:layout_height="@dimen/switch_height"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/button_close"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/sel_transparent_r12"
                        android:contentDescription="@string/action_close"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        app:tint="@color/md_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.djremixpro.core.ui.widget.KnobView
                        android:id="@+id/knob_wet_dry"
                        android:layout_width="@dimen/knob_size_fx"
                        android:layout_height="@dimen/knob_size_fx"
                        app:mdDeck="a" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fx_wet_dry"
                            android:textAppearance="@style/TextAppearance.MixDeck.Caption" />

                        <TextView
                            android:id="@+id/text_wet_dry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.MixDeck.Numeric"
                            tools:text="60%" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/fx_beat_length"
                    android:textAppearance="@style/TextAppearance.MixDeck.Caption" />

                <LinearLayout
                    android:id="@+id/layout_beat_lengths"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="@dimen/space_6"
                    android:orientation="horizontal" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reset"
                    style="@style/Widget.MixDeck.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_dialog_height"
                    android:minHeight="@dimen/button_dialog_height"
                    android:text="@string/fx_reset"
                    app:icon="@drawable/ic_reset"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_8"
                    app:iconSize="@dimen/icon_18"
                    app:iconTint="@color/md_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_20"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fx_drag_hint"
                        android:textAppearance="@style/TextAppearance.MixDeck.Caption" />

                    <TextView
                        android:id="@+id/text_readout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.MixDeck.Numeric"
                        tools:text="1/2 beat · 70%" />
                </LinearLayout>

                <com.example.djremixpro.core.ui.widget.XYPadView
                    android:id="@+id/xy_pad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_6"
                    android:layout_weight="1"
                    app:mdDeck="a" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
