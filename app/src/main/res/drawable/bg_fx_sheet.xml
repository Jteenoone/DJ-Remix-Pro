<?xml version="1.0" encoding="utf-8"?>
<!-- FX sheet (Mixer:219): panel, radius 24 on top, 1dp line border except the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_line" />
            <corners android:topLeftRadius="@dimen/radius_24" android:topRightRadius="@dimen/radius_24" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel" />
            <corners android:topLeftRadius="@dimen/radius_24" android:topRightRadius="@dimen/radius_24" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
