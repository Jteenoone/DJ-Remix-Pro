    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel" />
            <corners android:radius="@dimen/radius_12" />
            <stroke android:width="@dimen/stroke_1_5" android:color="@color/md_rec" />
        </shape>
    </item>
</ripple>
