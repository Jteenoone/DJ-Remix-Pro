<?xml version="1.0" encoding="utf-8"?>
<!-- Library panel (Mixer:321): panel, radius 24 on the left, 1dp line border on the left edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_line" />
            <corners android:topLeftRadius="@dimen/radius_24" android:bottomLeftRadius="@dimen/radius_24" android:topRightRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel" />
            <corners android:topLeftRadius="@dimen/radius_24" android:bottomLeftRadius="@dimen/radius_24" android:topRightRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
