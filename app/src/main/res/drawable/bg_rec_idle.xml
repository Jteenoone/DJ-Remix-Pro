<?xml version="1.0" encoding="utf-8"?>
<!-- REC button idle (Mixer:30): panel fill, 1.5 border in panel colour. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/md_raised">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel" />
            <corners android:radius="@dimen/radius_12" />
            <stroke android:width="@dimen/stroke_1_5" android:color="@color/md_panel" />
        </shape>
    </item>
</ripple>
