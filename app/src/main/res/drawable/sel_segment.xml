<?xml version="1.0" encoding="utf-8"?>
<!-- Segment item (App:148, App:196): selected = raised r10, otherwise transparent with a pressed ripple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_raised" />
            <corners android:radius="@dimen/radius_10" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/md_raised">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="@dimen/radius_10" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
